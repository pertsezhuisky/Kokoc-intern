                  "});",
                  "",
                  "pm.test(\"Все задачи принадлежат пользователю 2\", function () {",
                  "    const json = pm.response.json();",
                  "    json.tasks.forEach(function(task) {",
                  "        pm.expect(task.user_id).to.eql(2);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "4. Некорректный ID пользователя",
