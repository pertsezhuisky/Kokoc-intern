            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"user_id\": 1,\n    \"title\": \"Test task\",\n    \"description\": \"Testing task creation through Postman\"\n}"
