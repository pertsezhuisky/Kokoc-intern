    {
      "name": "GET /api/users/{id}/tasks - Задачи пользователя",
      "item": [
        {
          "name": "1. Получение задач существующего пользователя",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/1/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "1",
                "tasks"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Статус ответа 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Ответ содержит user_id\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"user_id\");",
                  "    pm.expect(json.user_id).to.eql(1);",
                  "});",
                  "",
                  "pm.test(\"Ответ содержит массив tasks\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.tasks).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"Ответ содержит count\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"count\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
